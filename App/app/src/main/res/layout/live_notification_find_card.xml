<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 1. 左侧区域：Tag 图标（调整为72dp大图标） -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/live_device_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:src="@drawable/ic_notification_tag_card" />
    </FrameLayout>

    <!-- 2. 中心区域：三行文本均居中显示（自适应填充，绝对居中） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="18dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 第 1 行: tag名称 -->
        <TextView
            android:id="@+id/live_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="YuiTag"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/live_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 第 2 行: 距离提示文本（如“在附近”） -->
        <TextView
            android:id="@+id/live_distance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginTop="3dp"
            android:text="在附近"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 第 3 行: 状态与趋势文本（如“正在接近”） -->
        <TextView
            android:id="@+id/live_trend_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginTop="3dp"
            android:text="正在接近"
            android:textSize="13.5sp"
            android:textColor="#888888"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 3. 右侧区域：操作按钮竖向排列（36dp圆形按钮，间距加大至8dp，与左侧保持严格视觉对称） -->
    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 响铃按钮 (在上) -->
        <ImageView
            android:id="@+id/live_btn_ring"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/live_notification_circle_btn_bg"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="响铃"
            android:src="@drawable/ic_notification_btn_ring" />

        <!-- 退出按钮 (在下) -->
        <ImageView
            android:id="@+id/live_btn_exit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/live_notification_circle_btn_bg"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="结束查找"
            android:src="@drawable/ic_notification_btn_close" />
    </LinearLayout>
</LinearLayout>
